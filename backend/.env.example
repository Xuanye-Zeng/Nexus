DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Adzuna Jobs API (https://developer.adzuna.com/admin/access_details)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Optional — LangSmith tracing. When LANGSMITH_TRACING=true AND
# LANGSMITH_API_KEY is set, LangChain auto-instruments every LLM call and
# pushes traces to LangSmith. Nexus also captures a run id per agent
# invocation in agent_runs.langsmith_trace_id so you can cross-reference.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexus-dev
